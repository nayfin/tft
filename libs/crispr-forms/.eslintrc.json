{
  "extends": "../../.eslintrc.json",
  "ignorePatterns": ["!**/*"],
  "overrides": [
    {
      "files": ["*.ts"],
      "extends": [
        "plugin:@nx/angular",
        "plugin:@angular-eslint/template/process-inline-templates"
      ],
      "parserOptions": {
        "project": ["libs/crispr-forms/tsconfig.*?.json"]
      },
      "rules": {
        "@angular-eslint/directive-selector": [
          "error",
          {
            "type": "attribute",
            "prefix": "crispr",
            "style": "camelCase"
          }
        ],
        "@angular-eslint/component-selector": [
          "error",
          {
            "type": "element",
            "prefix": "crispr",
            "style": "kebab-case"
          }
        ],
        "@angular-eslint/prefer-standalone": "off"
      }
    },
    {
      "files": [
        "public-api.ts",
        "src/index.ts",
        "src/lib/public_api.ts",
        "src/lib/ui/public-api.ts",
        "src/lib/ui/index.ts",
        "src/lib/crispr-forms.module.ts",
        "src/lib/field.directive.ts",
        "src/lib/display-field.directive.ts",
        "src/lib/form/**/*.ts",
        "src/lib/pipes/**/*.ts",
        "src/lib/utils/**/*.ts"
      ],
      "excludedFiles": ["*.spec.ts", "*.stories.ts"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "ExportAllDeclaration[source.value=/^([.]+.)+(ui.)?(autocomplete-chiplist-field|autocomplete-field|button|checkbox-field|datepicker-field|divider|image-upload-field|input-field|map|option|radio-field|select-field|slider-field|textarea-field|unit-conversion-field|form-group-list|sub-group)(.(index|public-api))?$/]",
            "message": "Lazily loaded field components must not be value exports. Use `export type { X } from '...'`, or Rollup inlines the lazy chunks into the entry bundle (see CREATE_FIELD.md)."
          },
          {
            "selector": "ExportNamedDeclaration[exportKind='value'][source.value=/^([.]+.)+(ui.)?(autocomplete-chiplist-field|autocomplete-field|button|checkbox-field|datepicker-field|divider|image-upload-field|input-field|map|option|radio-field|select-field|slider-field|textarea-field|unit-conversion-field|form-group-list|sub-group)(.(index|public-api))?$/]",
            "message": "Lazily loaded field components must not be value exports. Use `export type { X } from '...'`, or Rollup inlines the lazy chunks into the entry bundle (see CREATE_FIELD.md)."
          },
          {
            "selector": "ImportDeclaration[importKind='value'][source.value=/^([.]+.)+(ui.)?(autocomplete-chiplist-field|autocomplete-field|button|checkbox-field|datepicker-field|divider|image-upload-field|input-field|map|option|radio-field|select-field|slider-field|textarea-field|unit-conversion-field|form-group-list|sub-group)(.(index|public-api))?$/]",
            "message": "Eagerly loaded code must not import lazily loaded field components as values; use `import type`, or load them through FIELD_COMPONENTS (see CREATE_FIELD.md)."
          }
        ]
      }
    },
    {
      "files": ["*.html"],
      "extends": ["plugin:@nx/angular-template"],
      "rules": {}
    }
  ]
}
