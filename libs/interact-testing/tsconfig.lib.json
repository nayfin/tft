{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/libs/interact-testing",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "sourceMap": true,
    "module": "commonjs",
    "moduleResolution": "node10",
    "importHelpers": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/*.spec.ts",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
